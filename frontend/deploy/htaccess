# Apache config for Hostpoint. vite.config.js copies this into dist/.htaccess
# on `npm run build` and fills in the CSP placeholders - edit this file,
# not the generated one.

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Single-page app: paths like /trips/abc have no file on disk, so serve
  # index.html and let React Router resolve them.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set {{CSP_HEADER}} "{{CSP}}"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  # Keeps the origin in the Referer, which the Maps key's referrer restriction needs
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=()"
  Header always set Strict-Transport-Security "max-age=31536000"

  # Build assets have a content hash in their name and never change;
  # index.html must be revalidated so a new deploy is picked up.
  <FilesMatch "\.(js|css|png|jpe?g|svg|webp|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
