# Server key: restrict to Geocoding, Places and Directions API in the Google Cloud Console
GOOGLE_MAPS_API_KEY=

# Firebase project whose ID tokens the API accepts
FIREBASE_PROJECT_ID=

# Deployed frontend origin, e.g. https://trippin.onrender.com (no trailing slash).
# Only this origin (plus localhost:5173 outside production) may call the API.
FRONTEND_URL=

NODE_ENV=development
PORT=5000

# Only used by `npm test` (connection checks)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
